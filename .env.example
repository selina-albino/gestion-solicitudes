APP_NAME="Gestion de Solicitudes"
APP_ENV=local
# Se genera con: php artisan key:generate  (nunca subir el .env al repositorio)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Este incremento no usa base de datos: las solicitudes se guardan en un archivo JSON.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Ruta del archivo de datos (relativa a storage/app). Opcional.
SOLICITUDES_ARCHIVO=solicitudes.json
